    {
      "id": "term.gross_profit_amount",
      "kind": "terminology",
      "domain": "accounting_reconciliation",
      "title": "毛利额",
      "statement": "毛利额是营业收入减营业成本后的金额，区别于毛利率这一比率口径。",
      "basis": "《企业会计准则——应用指南》利润表项目与 6001、6401 科目配比关系（仅引用条款号）。",
      "source_id": "cas-account-guide",
