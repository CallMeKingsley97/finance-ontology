    {
      "id": "term.customer_count",
      "kind": "terminology",
      "domain": "business_finance_integration",
      "title": "客户数",
      "statement": "客户数指期间内有销售发票的去重客户数量，按销售发票口径统计，采购发票与无发票客户不计入。",
      "basis": "Odoo/ERPNext/GnuCash 销售流程模型概念参考（仅借鉴模型思想）；客户活跃度统计为行业通识。",
      "source_id": "odoo-erpnext-gnucash",
      "version": "1.0.0",
      "effective_from": "2025-01",
      "confidence": "practice",
      "payload": {
        "phrase": "客户数",
        "target_kind": "metric",
        "target_code": "active_customer_count"
      },
      "links": [
        {"target_kind": "metric", "target_code": "active_customer_count"}
      ]
    },
    {
      "id": "term.budget_achievement",
      "kind": "terminology",
      "domain": "business_finance_integration",
      "title": "预算达成",
      "statement": "预算达成指实际营业收入与预算营业收入的比值，以预算达成率表示，预算为零时返回 0。",
      "basis": "Cube 指标口径 schema 的 ratio measure 建模思想（Apache-2.0，改写引用）；预算考核为管理会计通识。",
      "source_id": "cube",
      "version": "1.0.0",
