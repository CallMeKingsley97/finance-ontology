    {
      "id": "term.receivable",
      "kind": "terminology",
      "domain": "accounting_reconciliation",
      "title": "欠款",
      "statement": "欠款指企业因销售商品或提供服务应向客户收取而尚未收到的款项，对应应收账款指标。",
      "basis": "《企业会计准则——应用指南》会计科目表 1122 应收账款（仅引用条款号）。",
      "source_id": "cas-account-guide",
      "version": "1.0.0",
      "effective_from": "2025-01",
      "confidence": "standard",
      "payload": {
        "phrase": "欠款",
        "target_kind": "metric",
        "target_code": "receivable_total"
      },
      "links": [
        {"target_kind": "metric", "target_code": "receivable_total"}
      ]
    },
    {
      "id": "term.bad_debt",
      "kind": "terminology",
      "domain": "accounting_reconciliation",
      "title": "呆账",
      "statement": "呆账指长期未能收回、收回可能性较低的应收款项，问数时归一到应收账款指标并提示坏账风险。",
      "basis": "《企业会计准则——应用指南》会计科目表 1122 应收账款坏账准备与减值计提关系（仅引用科目与条款号）。",
      "source_id": "cas-account-guide",
      "version": "1.0.0",
      "effective_from": "2025-01",
      "confidence": "standard",
      "payload": {
        "phrase": "呆账",
        "target_kind": "metric",
        "target_code": "receivable_total"
      },
      "links": [
        {"target_kind": "metric", "target_code": "receivable_total"}
      ]
    },
    {
      "id": "term.turnover",
      "kind": "terminology",
      "domain": "accounting_reconciliation",
      "title": "营业额",
      "statement": "营业额是营业收入的口语说法，取收入类科目本期贷方发生额减借方发生额。",
      "basis": "《企业会计准则第14号——收入》与 6001 主营业务收入科目（仅引用准则名称与条款号）。",
      "source_id": "cas-account-guide",
