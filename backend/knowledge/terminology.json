    {
      "id": "term.loan",
      "kind": "terminology",
      "domain": "accounting_reconciliation",
      "title": "借款",
      "statement": "借款在问数语境中泛指企业承担的负债，归一到负债总额指标；区分短期借款与长期借款需进一步限定。",
      "basis": "《企业会计准则——基本准则》第二十三条负债定义（仅引用条款号）。",
      "source_id": "cas-basic",
      "version": "1.0.0",
      "effective_from": "2025-01",
      "confidence": "standard",
      "payload": {
        "phrase": "借款",
        "target_kind": "metric",
        "target_code": "total_liabilities"
      },
      "links": [
        {"target_kind": "metric", "target_code": "total_liabilities"}
      ]
    },
    {
      "id": "term.cash_flow",
      "kind": "terminology",
      "domain": "business_finance_integration",
      "title": "现金流",
      "statement": "现金流在问数语境中对应经营现金净流入，即期间收款合计减付款合计，为收付款口径。",
      "basis": "复式记账法与收付款核销业务通识；本项目口径不等同现金流量表准则口径。",
      "source_id": "double-entry",
      "version": "1.0.0",
      "effective_from": "2025-01",
      "confidence": "practice",
      "payload": {
        "phrase": "现金流",
        "target_kind": "metric",
        "target_code": "operating_cash_flow"
      },
      "links": [
        {"target_kind": "metric", "target_code": "operating_cash_flow"}
      ]
    },
    {
      "id": "term.expense_ratio",
      "kind": "terminology",
      "domain": "business_finance_integration",
      "title": "费用率",
      "statement": "费用率指期间费用与营业收入的比值，以小数返回，收入为零时返回 0。",
      "basis": "《企业会计准则——应用指南》损益类科目口径与财务分析通识（仅引用条款号）。",
      "source_id": "cas-account-guide",
