      ]
    },
    {
      "id": "term.inventory",
      "kind": "terminology",
      "domain": "accounting_reconciliation",
      "title": "库存",
      "statement": "库存是存货的口语说法，指企业持有以备出售或耗用的商品与材料，对应存货指标。",
      "basis": "《企业会计准则第1号——存货》与 1405 存货科目（仅引用准则名称与条款号）。",
      "source_id": "cas-account-guide",
