# ===== 前端 / Next.js =====
# Next.js rewrite 代理目标（后端 FastAPI 地址）。浏览器始终只访问同源 /api/*。
BACKEND_URL=http://127.0.0.1:8000

# ===== 后端 / FastAPI =====
# SQLite 数据库文件路径。留空时默认 <repo>/data/finance.db（与启动目录无关）。
# 绝对路径或相对当前工作目录的路径均可。
DATABASE_PATH=

# ===== 可选 LLM 增强（不配置时完全使用规则引擎，功能可用）=====
# 以下三个变量同时存在才会启用 LLM；任何调用失败都会自动回退规则引擎。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# LLM 请求超时秒数，默认 15
LLM_TIMEOUT_SECONDS=15

# ===== 多数据源接入 =====
# 数据源注册库路径。留空时默认 <DATABASE_PATH 同目录>/sources.db；
# 与 finance.db 物理隔离，重新播种不会清空注册信息。
SOURCES_DATABASE_PATH=
# 上传文件根目录。留空时默认 <SOURCES_DATABASE_PATH 同目录>/uploads。
UPLOAD_DIR=
# Fernet 密钥（base64）。留空时自动在注册库同目录创建 .source_key（0600）。
# 密钥丢失后已存凭据无法解密，只能删除数据源重建。
SOURCE_SECRET_KEY=
# 外部数据库主机白名单，逗号分隔；留空表示不限制（仅适合内网演示）。
SOURCE_ALLOWED_HOSTS=
# 数据库源元数据缓存 TTL（秒），默认 300。
SOURCE_METADATA_TTL_SECONDS=300
# 元数据上限：表数 / 单表列数 / JSON 字节数。
SOURCE_MAX_TABLES=200
SOURCE_MAX_COLUMNS=500
SOURCE_MAX_METADATA_BYTES=2000000
# 上传大小上限（字节）：CSV 50MB / Excel 20MB / SQLite 100MB。
SOURCE_MAX_CSV_BYTES=52428800
SOURCE_MAX_EXCEL_BYTES=20971520
SOURCE_MAX_SQLITE_BYTES=104857600
# 样本行上限，默认 20。
SOURCE_SAMPLE_LIMIT=20

# ===== 数据同步与 staging =====
# staging 独立 SQLite 库路径。留空时默认 <DATABASE_PATH 同目录>/staging.db；
# 与 finance.db、sources.db 物理隔离。首次创建后尽力设置 0600 权限。
STAGING_DATABASE_PATH=
# 单批读取/写入行数，默认 1000。
STAGING_BATCH_SIZE=1000
# 单表行数上限，默认 200000；超出截断并记录 warning，不静默丢数据。
STAGING_MAX_ROWS_PER_TABLE=200000
# 单表近似字节上限，默认 67108864（64MiB）；超出截断并记录 warning。
STAGING_MAX_BYTES_PER_TABLE=67108864
# 源级失败重试次数（首次之外），默认 3；表级失败不重试。
STAGING_MAX_RETRIES=3
# 指数退避基数（秒），默认 1.0，序列 1s/2s/4s，单次上限 30s。
STAGING_RETRY_BACKOFF_SECONDS=1.0
# 心跳超过该秒数判定运行中断，默认 300。
STAGING_RUN_STALE_SECONDS=300
# 同步运行记录保留天数，默认 180；目录与变更日志不自动清理。
STAGING_RUN_RETENTION_DAYS=180
# 单次批量同步源上限，默认 50。
STAGING_MAX_BATCH_SOURCES=50
# 外部 cron 服务令牌（仅通过 X-Service-Token 请求头传入）。
# 留空表示关闭令牌通道，批量同步只能由 admin 触发；禁止写入真实令牌。
SYNC_SERVICE_TOKEN=

# ===== 外部 auto-ontology 绑定 =====
# 可选的外部本体服务主机白名单，逗号分隔；留空表示不限制主机。
# 无论是否配置白名单，均拦截云元数据主机/IP、链路本地地址与未指定地址。
AUTO_ONTOLOGY_ALLOWED_HOSTS=
# 探测超时上限（秒），默认 5，硬上限 10；请求值超过该上限会被拒绝而非截断。
AUTO_ONTOLOGY_MAX_TIMEOUT_SECONDS=5.0
# 探测响应体读取上限（字节），默认 65536；超出只标记 truncated，不视为失败。
AUTO_ONTOLOGY_MAX_RESPONSE_BYTES=65536
